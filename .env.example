WMS_HOST=0.0.0.0
WMS_PORT=9000
WMS_HTTP_PORT=8080
WMS_APP_VERSION=1.0.0

WMS_CORS_ALLOWED_ORIGINS=http://localhost:8080
WMS_DEVICE_API_KEY=change-me-device-key
WMS_DEVICE_RATE_LIMIT_RPM=120
WMS_MAX_INGEST_BODY_BYTES=32768

WMS_JWT_SECRET=change-me-jwt-secret
WMS_JWT_ALGORITHM=HS256
WMS_TCP_HMAC_SECRET=change-me-tcp-hmac
WMS_RATE_LIMIT_RPM=1000

WMS_CSP_POLICY=default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';
